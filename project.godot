; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Asteroid Escort"
run/main_scene="uid://baptqkmsj4gtb"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="uid://bey0k0m1qhnp8"

[audio]

driver/output_latency=1
driver/output_latency.web=90
driver/mix_rate=48000

[autoload]

MultiplayerSessionManager="*res://singletons/multiplayer_session_manager/multiplayer_session_manager.tscn"
SignalBus="*res://singletons/signal_bus.gd"
Gamedata="*res://singletons/gamedata.gd"
Console="*res://singletons/console.gd"
Settings="*res://singletons/settings.gd"
MusicManager="*res://singletons/music_manager/music_manager.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[global_group]

player="To find all the player nodes"
indicated=""
tutorial_indicator_CORE=""
tutorial_indicator_ASTEROID=""
tutorial_indicator_ALIEN=""
tutorial_indicator_BUILD_MENU_ENTRY=""
tutorial_indicator_ORE=""
tutorial_indicator_GOAL=""
tutorial_indicated=""
tutorial_indicator_THRUSTER=""

[gui]

theme/custom_font="uid://dyj0htea4my1e"

